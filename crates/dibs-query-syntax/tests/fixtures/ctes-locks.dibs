query RecursiveAndLocks(root: text) -> many {
    with recursive dependency_path(job_id, path) as materialized (
        select edge.job_id, array[edge.job_id]::text[]
        from fleet_job_dependency as edge
        where edge.blocking_job_id = :root
        union all
        select edge.job_id, path.path || edge.job_id
        from dependency_path as path
        join fleet_job_dependency as edge on edge.blocking_job_id = path.job_id
        where not edge.job_id = any(path.path)
    ), initialized as (
        insert into fleet_cursor(id, position)
        values (1, 0)
        on conflict (id) do nothing
        returning id
    ), candidate as not materialized (
        select job.id
        from fleet_job as job
        where exists(select 1 from initialized)
        order by job.id
        for no key update of job nowait
        for key share of job skip locked
        limit 1
    )
    update fleet_job as job
    set state = 'claimed'
    from candidate
    where job.id = candidate.id
    returning job.id, job.state
}
