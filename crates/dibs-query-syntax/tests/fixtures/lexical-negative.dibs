query Lexical(real: text) -> one {
    select
        :real::text,
        fn(arg := ':not_a_bind'),
        $tag$:tagged_not_a_bind$tag$,
        E'escaped \\:escaped_not_a_bind',
        U&'unicode \\0063:not_a_bind',
        B'0101:bit_not_a_bind',
        X'CAFE:hex_not_a_bind',
        "quoted:identifier",
        /* outer :comment_not_a_bind /* nested :still_not_a_bind */ outer */
        1 -- :line_comment_not_a_bind
}
