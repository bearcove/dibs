query WindowForms() -> many {
    select
        event.job_id,
        row_number() over job_order as row_number,
        sum(event.duration_ms) filter (where event.duration_ms > 0) over (
            partition by event.job_id
            order by event.sequence
            rows between 2 preceding and current row
            exclude ties
        ) as rolling_duration,
        last_value(event.state) over (
            job_order
            groups between unbounded preceding and 1 following
            exclude no others
        ) as last_state,
        count(*) over (
            partition by event.job_id
            order by event.sequence
            range between current row and unbounded following
            exclude current row
        ) as remaining
    from fleet_event as event
    window job_order as (
        partition by event.job_id
        order by event.sequence
        rows between unbounded preceding and current row
        exclude group
    )
}
